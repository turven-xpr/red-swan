# ─────────────────────────────────────────────────────────────────────
# Deutschy → Gemini proxy — local environment template.
# Copy this file to `.env` (or set the values via your platform's
# secret store / `fly secrets` / Render dashboard) and fill in:
# ─────────────────────────────────────────────────────────────────────

# Gemini API key — get a free one at
# https://aistudio.google.com/app/apikey  (no credit card required).
# The key stays ONLY on the server.  Do NOT bundle it into the Flutter app.
GEMINI_API_KEY=

# Comma-separated origins allowed to call this proxy.
# During local development typical values are:
#   http://localhost:8080,http://10.0.2.2:8080
# In production set this to your deployed web/app front-door origin.
# Leave empty to allow any origin (NOT recommended in production).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://10.0.2.2:8080

# Optional.  Overridden automatically by the deployment platform.
# Fly.io uses 8080 by default — keep them in sync.
PORT=3000
